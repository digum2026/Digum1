{
  "entities": {
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "School class document holding class metadata and student lists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "grade": { "type": "string" },
        "number": { "type": "number" },
        "fullName": { "type": "string" },
        "teacherName": { "type": "string" },
        "mks": { "type": "string" },
        "track": { "type": "string" },
        "students": { "type": "array" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "grade", "number", "fullName", "students", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "School classes collection synchronized in real-time"
    }
  }
}
